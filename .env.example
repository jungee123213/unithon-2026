# ── T2 백엔드 전용 (Vercel 환경변수에만. 커밋 금지 — §9.3) ──────────
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
ANTHROPIC_API_KEY=

# 요약 모델 (기본값: claude-sonnet-5)
TEAMSYNC_MODEL=claude-sonnet-5

# ── T3 프론트 (Realtime 구독. 브라우저에 노출됨 — RLS 로 읽기만 허용) ──
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── 훅 ↔ API 공유 시크릿 (로컬 settings.json 과 Vercel 양쪽에 같은 값) ──
TEAMSYNC_TOKEN=

# 기본 프로젝트 (/ 접속 시 리다이렉트 대상)
TEAMSYNC_PROJECT_ID=unithon
