# ══════════════════════════════════════════════════════════════════
# TeamSync 환경변수 — .env.local 로 복사해서 채웁니다.
#
#  [자동]  scripts/setup-supabase.sh 가 채웁니다.
#  [수동]  직접 값을 넣어야 합니다.
#  [셋업]  스크립트 실행에만 쓰이고 배포 환경에는 넣지 않습니다.
#
# 팀원이라면 이 파일이 필요 없습니다 — docs/팀원-설치.md 를 보세요.
# 여기 있는 값들은 서버를 직접 띄우거나 배포하는 사람에게만 필요합니다.
# ══════════════════════════════════════════════════════════════════

# ── [셋업] Supabase 관리 토큰 ──────────────────────────────────────
# 프로젝트 생성·스키마 적용에만 씁니다. 앱 런타임에는 쓰이지 않습니다.
# 계정 전체 권한이므로 Vercel 환경변수에 넣지 마세요.
# 발급: https://supabase.com/dashboard/account/tokens
SUPABASE_ACCESS_TOKEN=

# ── [셋업] Vercel 배포 토큰 ────────────────────────────────────────
# scripts/deploy-vercel.sh 가 씁니다. 역시 배포 환경에 넣지 마세요.
# 발급: https://vercel.com/account/tokens
VERCEL_TOKEN=

# ── [수동] 요약 LLM ────────────────────────────────────────────────
# 비어 있으면 /api/ingest 가 500 을 내고, 훅은 pending 큐에만 쌓습니다.
# 즉 A→B 전파가 동작하지 않습니다.
# 발급: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# 요약 모델 (기본값 유지 권장)
TEAMSYNC_MODEL=claude-sonnet-5

# ── [자동] Supabase — 서버 전용 ────────────────────────────────────
# service_role 키는 RLS 를 우회합니다. 절대 클라이언트로 나가면 안 됩니다 (§9.3).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ── [자동] Supabase — 브라우저 ─────────────────────────────────────
# Realtime 구독과 로그인 세션에 씁니다. RLS 로 읽기만 가능합니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── [수동] 앱 주소 ─────────────────────────────────────────────────
# 프로젝트 화면이 훅 설치 명령에 이 주소를 박아 넣습니다.
# 배포별 URL(...-<scope>.vercel.app)이 아니라 공개 별칭을 써야 합니다 — EX-8 참조.
NEXT_PUBLIC_APP_URL=https://teamsync-ruddy.vercel.app

# ── [자동·선택] 구버전 공유 시크릿 ─────────────────────────────────
# 지금은 멤버별 토큰(tsk_...)이 프로젝트와 사람을 결정합니다.
# 이 값은 그 이전 방식으로 설치된 훅을 위한 폴백일 뿐입니다.
# 새로 설치하는 사람에게는 필요 없습니다.
TEAMSYNC_TOKEN=

# ── [수동·선택] 로컬 기본 프로젝트 ─────────────────────────────────
# scripts/seed-demo.mjs 의 기본 대상. 앱 동작에는 영향이 없습니다.
TEAMSYNC_PROJECT_ID=hankki
