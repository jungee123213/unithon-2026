{
  "//": "TeamSync — 프로젝트 스코프 .claude/settings.json 에만 넣는다 (§5.1 L1). ~/.claude/settings.json 금지.",
  "env": {
    "TEAMSYNC_API": "https://REPLACE-ME.vercel.app",
    "TEAMSYNC_PROJECT_ID": "unithon",
    "TEAMSYNC_MEMBER": "REPLACE-ME",
    "TEAMSYNC_TOKEN": "REPLACE-ME"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamsync/pull.sh\" SessionStart",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamsync/pull.sh\" UserPromptSubmit",
            "timeout": 15
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamsync/accumulate.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamsync/flush-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR/.claude/hooks/teamsync/flush-hook.sh\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
